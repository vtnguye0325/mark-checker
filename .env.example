# Required for Docker image build: Hugging Face model repo (snapshot_download)
HF_MODEL_ID=org/your-model-repo

# Optional: Hugging Face token for private/gated models (build-arg + runtime not needed if prebaked)
HF_TOKEN=

# Optional: required for POST /analyze (DeepSeek)
DEEPSEEK_API_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# TURNSTILE_SECRET: backend-only secret key — never expose to the browser
# VITE_TURNSTILE_SITE_KEY: public site key — safe to embed in the built JS bundle
# DISABLE_TURNSTILE=true: skip Turnstile check in local dev (only when TURNSTILE_SECRET unset)
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
# DISABLE_TURNSTILE=true

# Optional: comma-separated browser origins for CORS (defaults include localhost dev + Docker UI)
# CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Phase 8: Google accounts and query history ---
# Postgres superuser password (compose). Use only [A-Za-z0-9] — compose
# interpolates it into DATABASE_URL raw, and @ / : # break the URL parse.
# `openssl rand -hex 32` obeys that.
POSTGRES_PASSWORD=
# Backend database URL (defaults to the compose postgres service; override only for an external DB)
# DATABASE_URL=postgresql+asyncpg://markchecker:PASSWORD@postgres:5432/markchecker
# Google OAuth client id — same value in backend and frontend build. Public.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# HS256 key for the session JWT. Secret. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days)
# SESSION_TTL_HOURS=168
# Set false for plain-HTTP local dev (default true)
# COOKIE_SECURE=true
# /llm-assess caps
# RATE_LIMIT_ANALYZE_USER=5/hour
# RATE_LIMIT_ANALYZE_IP=20/hour
